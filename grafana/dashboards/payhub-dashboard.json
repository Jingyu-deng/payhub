{
  "title": "PayHub - Service Overview",
  "uid": "payhub-overview",
  "version": 2,
  "timezone": "browser",
  "panels": [
    {
      "title": "HTTP Requests (rate)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{application=\"payment-platform\"}[1m])",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "title": "HTTP Response Time (P99)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{application=\"payment-platform\"}[1m]))",
          "legendFormat": "P99 - {{uri}}"
        }
      ]
    },
    {
      "title": "Payment Initiate Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(payment_initiate_total{application=\"payment-platform\"}[1m])",
          "legendFormat": "initiate"
        }
      ]
    },
    {
      "title": "Payment Process Rate (by gateway)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(payment_process_total{application=\"payment-platform\"}[1m])",
          "legendFormat": "{{gateway}}"
        }
      ]
    },
    {
      "title": "Payment Error Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(payment_errors_total{application=\"payment-platform\"}[1m])",
          "legendFormat": "{{exception}}"
        }
      ]
    },
    {
      "title": "Payment Duration (P99)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(payment_duration_seconds_bucket{application=\"payment-platform\"}[1m]))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "title": "JVM Heap Memory",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"payment-platform\", area=\"heap\"}",
          "legendFormat": "Heap"
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"payment-platform\", area=\"heap\"}",
          "legendFormat": "Max Heap"
        }
      ]
    },
    {
      "title": "JVM GC Pause Time",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"payment-platform\"}[1m])",
          "legendFormat": "{{action}}"
        }
      ]
    }
  ]
}
