@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container diagram for PayHub

Person(customer, "Customer", "Initiates payments")

System_Boundary(payhub, "PayHub") {
    Container(payment_platform, "Payment Platform", "Spring Boot", "Handles payment initiation, processing, status checks")
    ContainerDb(kafka, "Kafka", "Message Broker", "payment-events topic")
    ContainerDb(redis, "Redis", "Cache / Lock", "Idempotency locks, distributed locks")
    ContainerDb(postgres, "PostgreSQL", "Database", "Stores payments and audit logs (Flyway migrations)")
    System_Ext(payment_gateway, "Payment Gateway", "External API for payment processing")
    ContainerDb(prometheus, "Prometheus", "Time Series DB", "Metrics collection & querying")
    ContainerDb(jaeger, "Jaeger", "Tracing Server", "Distributed trace storage & query")
    Container(grafana, "Grafana", "Dashboard", "Metrics & tracing visualization")
}

Rel(customer, payment_platform, "POST /api/payments")
Rel(payment_platform, kafka, "Publishes/Consumes events")
Rel(payment_platform, redis, "Reads/Writes")
Rel(payment_platform, postgres, "Reads/Writes (Flyway-managed schema)")
Rel(payment_platform, payment_gateway, "Calls to process payment")
Rel(payment_platform, prometheus, "Exposes metrics (actuator)")
Rel(payment_platform, jaeger, "Sends traces (OTLP)")
Rel(grafana, prometheus, "Queries metrics")

@enduml